# Copy to backend/.env. Take the URI from Supabase Dashboard > Connect (use the Session pooler
# if your network has no IPv6), switch the scheme to postgresql+psycopg://, keep sslmode=require,
# and URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# Uploaded course material is stored on local disk. Relative paths resolve from backend/.
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# Creates the first administrator: python -m app.scripts.create_admin
# Remove the password from this file once the admin exists.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Frontend (frontend/.env or your shell). The API runs on port 8000 unless you change it.
VITE_API_BASE_URL=http://localhost:8000/api/v1
